# Copy this file to `.env` (same folder as manage.py) for local development,
# or set these as environment variables on your host (e.g. Render dashboard).
# `.env` is git-ignored. Never commit real secrets.

# Local dev: True. Production: False.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Where the React app lives (used in password-reset emails)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://react-portfolio-new-y91w.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Optional hosted database, e.g. postgres://user:pass@host:5432/dbname
# Leave empty to use the local db.sqlite3
DATABASE_URL=

# Gmail SMTP (use a Gmail App Password). If empty, emails are printed to the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=

# GitHub token for the "total commits" counter on the About page
GITHUB_TOKEN=
GITHUB_USERNAME=hari-haran80

# Cloudinary (profile pictures, project and skill images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
