# Template for PortFolio_BE/.env. Copy to `.env` and fill in real values.
# `.env` is git-ignored. On Render, upload it as a Secret File named `.env`
# (Environment -> Secret Files) or add each line as an Environment Variable.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
ENCRYPTION_KEY=

FRONTEND_URL=https://react-portfolio-new-y91w.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://react-portfolio-new-y91w.onrender.com
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Email. BREVO_API_KEY (starts with xkeysib-) sends over HTTPS and works on Render's
# free plan, which blocks SMTP. Without it, the SMTP settings below are used.
BREVO_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=Hariharan Portfolio
ADMIN_EMAIL=

GITHUB_TOKEN=
GITHUB_USERNAME=hari-haran80

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEFAULT_PROFILE_PICTURE_URL=

# Empty = local db.sqlite3. Otherwise postgres://... or mysql://...
DATABASE_URL=
